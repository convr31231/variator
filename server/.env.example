# Локальная разработка: скопируйте в server/.env
# Продакшен: используйте deploy/.env (см. deploy/.env.example)

PORT=8780
HOST=0.0.0.0

# Постоянный каталог на диске (относительно server/ или абсолютный путь)
# В Docker задаётся DATA_DIR=/data
DATA_DIR=../data

# Случайная длинная строка для cookie-parser / сессий (минимум 32 символа)
SESSION_SECRET=замените_на_случайную_длинную_строку

# false для http://127.0.0.1 ; true только за HTTPS
COOKIE_SECURE=false

# Через запятую. Локально:
ALLOWED_ORIGINS=http://localhost:8780,http://127.0.0.1:8780
# На сервере: https://ваш-домен.ru

UPLOAD_MAX_BYTES=8388608
