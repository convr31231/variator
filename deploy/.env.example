# Скопируйте в deploy/.env на сервере и заполните.
# Файл deploy/.env НЕ коммитить.

# Домен сайта (без https://), например: ftc.example.ru
SITE_ADDRESS=example.com

# Email для Let's Encrypt (Caddy)
ACME_EMAIL=admin@example.com

# Origins админки через запятую (обязательно https-домен)
ALLOWED_ORIGINS=https://example.com

# true за HTTPS (продакшен)
COOKIE_SECURE=true

# Случайная длинная строка (>= 32 символов), не из примеров
SESSION_SECRET=замените_на_случайную_длинную_строку

# Лимит загрузки (байты), по умолчанию 8 МБ
UPLOAD_MAX_BYTES=8388608
